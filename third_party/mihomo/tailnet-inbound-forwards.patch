+//go:build with_gvisor && !no_tailscale
+
+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestParseTailscaleInboundForwards(t *testing.T) {
+	config := RawConfig{Proxy: []map[string]any{{
+		"name":     "tailnet",
+		"type":     "tailscale",
+		"hostname": "test-node",
+		"inbound-forwards": []any{
+			map[string]any{"name": "ssh", "network": "tcp", "listen-port": 22, "target": "127.0.0.1:22"},
+			map[string]any{"name": "udp", "network": "udp", "listen-port": 12345, "target": "127.0.0.1:12345"},
+		},
+	}}}
+	proxies, _, err := parseProxies(&config)
+	require.NoError(t, err)
+	require.Contains(t, proxies, "tailnet")
+	require.NoError(t, proxies["tailnet"].Close())
+}
+
+func TestParseTailscaleInboundForwardsRejectsInvalidTarget(t *testing.T) {
+	config := RawConfig{Proxy: []map[string]any{{
+		"name": "tailnet",
+		"type": "tailscale",
+		"inbound-forwards": []any{
+			map[string]any{"name": "ssh", "network": "tcp", "listen-port": 22, "target": "invalid"},
+		},
+	}}}
+	_, _, err := parseProxies(&config)
+	require.ErrorContains(t, err, "target must be host:port")
+}
