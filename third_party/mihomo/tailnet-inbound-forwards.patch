 func updateProxies(proxies map[string]C.Proxy, providers map[string]P.ProxyProvider) {
+	forwardStateDirs := make(map[string]struct{})
+	for _, proxy := range proxies {
+		if !outbound.HasInboundForwards(proxy.Adapter()) {
+			continue
+		}
+		if stateDir, ok := outbound.TailscaleStateDir(proxy.Adapter()); ok {
+			forwardStateDirs[stateDir] = struct{}{}
+		}
+	}
+	for _, proxy := range tunnel.Proxies() {
+		stateDir, isTailscale := outbound.TailscaleStateDir(proxy.Adapter())
+		_, stateDirWillHostForwards := forwardStateDirs[stateDir]
+		if outbound.HasInboundForwards(proxy.Adapter()) || (isTailscale && stateDirWillHostForwards) {
+			if err := proxy.Close(); err != nil {
+				log.Warnln("Close outdated proxy [%s] with inbound forwards failed: %v", proxy.Name(), err)
+			}
+		}
+	}
 	tunnel.UpdateProxies(proxies, providers)
+	for _, proxy := range proxies {
+		started, err := outbound.StartInboundForwards(proxy.Adapter())
+		if err != nil {
+			log.Errorln("Start inbound forwards for proxy [%s] failed: %v", proxy.Name(), err)
+		} else if started {
+			log.Infoln("Started inbound forwards for proxy [%s]", proxy.Name())
+		}
+	}
 }
 
 func updateRules(rules []C.Rule, subRules map[string][]C.Rule, ruleProviders map[string]P.RuleProvider) {
