diff --git a/adapter/outbound/tailscale_common.go b/adapter/outbound/tailscale_common.go
new file mode 100644
index 00000000..681c706b
--- /dev/null
+++ b/adapter/outbound/tailscale_common.go
@@ -0,0 +1,70 @@
+package outbound
+
+import (
+	"fmt"
+	"net"
+	"strconv"
+	"strings"
+)
+
+type TailscaleOption struct {
+	BasicOption
+	Name            string                    `proxy:"name"`
+	Hostname        string                    `proxy:"hostname,omitempty"`
+	AuthKey         string                    `proxy:"auth-key,omitempty"`
+	ControlURL      string                    `proxy:"control-url,omitempty"`
+	StateDir        string                    `proxy:"state-dir,omitempty"`
+	Ephemeral       bool                      `proxy:"ephemeral,omitempty"`
+	UDP             bool                      `proxy:"udp,omitempty"`
+	InboundForwards []TailscaleInboundForward `proxy:"inbound-forwards,omitempty"`
+
+	AcceptRoutes           *bool  `proxy:"accept-routes,omitempty"`
+	ExitNode               string `proxy:"exit-node,omitempty"`
+	ExitNodeAllowLANAccess *bool  `proxy:"exit-node-allow-lan-access,omitempty"`
+}
+
+type TailscaleInboundForward struct {
+	Name       string `proxy:"name"`
+	Network    string `proxy:"network"`
+	ListenPort int    `proxy:"listen-port"`
+	Target     string `proxy:"target"`
+}
+
+func normalizeTailscaleInboundForwards(forwards []TailscaleInboundForward) ([]TailscaleInboundForward, error) {
+	normalized := make([]TailscaleInboundForward, len(forwards))
+	names := make(map[string]struct{}, len(forwards))
+	listeners := make(map[string]struct{}, len(forwards))
+	for index, forward := range forwards {
+		forward.Name = strings.TrimSpace(forward.Name)
+		forward.Network = strings.ToLower(strings.TrimSpace(forward.Network))
+		forward.Target = strings.TrimSpace(forward.Target)
+		if forward.Name == "" {
+			return nil, fmt.Errorf("inbound-forwards[%d]: name is required", index)
+		}
+		if _, exists := names[forward.Name]; exists {
+			return nil, fmt.Errorf("inbound-forwards[%d]: duplicate name %q", index, forward.Name)
+		}
+		names[forward.Name] = struct{}{}
+		if forward.Network != "tcp" && forward.Network != "udp" {
+			return nil, fmt.Errorf("inbound-forwards[%d] %q: network must be tcp or udp", index, forward.Name)
+		}
+		if forward.ListenPort < 1 || forward.ListenPort > 65535 {
+			return nil, fmt.Errorf("inbound-forwards[%d] %q: listen-port must be between 1 and 65535", index, forward.Name)
+		}
+		listenerKey := fmt.Sprintf("%s/%d", forward.Network, forward.ListenPort)
+		if _, exists := listeners[listenerKey]; exists {
+			return nil, fmt.Errorf("inbound-forwards[%d] %q: duplicate tailnet listener %s", index, forward.Name, listenerKey)
+		}
+		listeners[listenerKey] = struct{}{}
+		host, port, err := net.SplitHostPort(forward.Target)
+		if err != nil || strings.TrimSpace(host) == "" {
+			return nil, fmt.Errorf("inbound-forwards[%d] %q: target must be host:port", index, forward.Name)
+		}
+		portNumber, err := strconv.Atoi(port)
+		if err != nil || portNumber < 1 || portNumber > 65535 {
+			return nil, fmt.Errorf("inbound-forwards[%d] %q: target port must be between 1 and 65535", index, forward.Name)
+		}
+		normalized[index] = forward
+	}
+	return normalized, nil
+}
diff --git a/adapter/outbound/tailscale_common_test.go b/adapter/outbound/tailscale_common_test.go
new file mode 100644
index 00000000..ccb3db0c
--- /dev/null
+++ b/adapter/outbound/tailscale_common_test.go
@@ -0,0 +1,44 @@
+package outbound
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestNormalizeTailscaleInboundForwards(t *testing.T) {
+	forwards, err := normalizeTailscaleInboundForwards([]TailscaleInboundForward{
+		{Name: " ssh ", Network: "TCP", ListenPort: 22, Target: "127.0.0.1:22"},
+		{Name: "dns", Network: "udp", ListenPort: 5353, Target: "[::1]:5353"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if forwards[0].Name != "ssh" || forwards[0].Network != "tcp" {
+		t.Fatalf("unexpected normalized forward: %+v", forwards[0])
+	}
+	if forwards[1].Target != "[::1]:5353" {
+		t.Fatalf("unexpected ipv6 target: %+v", forwards[1])
+	}
+}
+
+func TestNormalizeTailscaleInboundForwardsRejectsInvalidConfig(t *testing.T) {
+	testCases := []struct {
+		name     string
+		forwards []TailscaleInboundForward
+		want     string
+	}{
+		{name: "missing name", forwards: []TailscaleInboundForward{{Network: "tcp", ListenPort: 22, Target: "127.0.0.1:22"}}, want: "name is required"},
+		{name: "network", forwards: []TailscaleInboundForward{{Name: "x", Network: "icmp", ListenPort: 22, Target: "127.0.0.1:22"}}, want: "network must be tcp or udp"},
+		{name: "port", forwards: []TailscaleInboundForward{{Name: "x", Network: "tcp", ListenPort: 0, Target: "127.0.0.1:22"}}, want: "listen-port"},
+		{name: "target", forwards: []TailscaleInboundForward{{Name: "x", Network: "tcp", ListenPort: 22, Target: "127.0.0.1"}}, want: "target must be host:port"},
+		{name: "duplicate listener", forwards: []TailscaleInboundForward{{Name: "x", Network: "tcp", ListenPort: 22, Target: "127.0.0.1:22"}, {Name: "y", Network: "tcp", ListenPort: 22, Target: "127.0.0.1:23"}}, want: "duplicate tailnet listener"},
+	}
+	for _, testCase := range testCases {
+		t.Run(testCase.name, func(t *testing.T) {
+			_, err := normalizeTailscaleInboundForwards(testCase.forwards)
+			if err == nil || !strings.Contains(err.Error(), testCase.want) {
+				t.Fatalf("error = %v, want substring %q", err, testCase.want)
+			}
+		})
+	}
+}
diff --git a/adapter/outbound/tailscale_forward.go b/adapter/outbound/tailscale_forward.go
new file mode 100644
index 00000000..8135d2ee
--- /dev/null
+++ b/adapter/outbound/tailscale_forward.go
@@ -0,0 +1,470 @@
+//go:build with_gvisor && !no_tailscale
+
+package outbound
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	N "github.com/metacubex/mihomo/common/net"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/log"
+)
+
+const defaultTailscaleUDPForwardTimeout = 5 * time.Minute
+
+type tailscaleForwardServer interface {
+	Listen(network, address string) (net.Listener, error)
+	ListenPacket(network, address string) (net.PacketConn, error)
+	TailscaleIPs() (netip.Addr, netip.Addr)
+}
+
+type tailscaleInboundForwardSet struct {
+	proxyName  string
+	ctx        context.Context
+	cancel     context.CancelFunc
+	udpTimeout time.Duration
+	closeOnce  sync.Once
+	closeErr   error
+	wg         sync.WaitGroup
+
+	mu          sync.Mutex
+	closed      bool
+	closers     []io.Closer
+	connections map[net.Conn]struct{}
+	udpSessions map[string]*tailscaleUDPForwardSession
+}
+
+type tailscaleUDPForwardSession struct {
+	key        string
+	forward    TailscaleInboundForward
+	packetConn net.PacketConn
+	remote     net.Addr
+	target     net.Conn
+	lastSeen   atomic.Int64
+	closeOnce  sync.Once
+}
+
+func (t *Tailscale) startInboundForwards() error {
+	if len(t.option.InboundForwards) == 0 {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(t.ctx, 30*time.Second)
+	defer cancel()
+	if err := t.ensureStarted(ctx); err != nil {
+		return fmt.Errorf("start tailscale server: %w", err)
+	}
+
+	t.startCloseMu.Lock()
+	defer t.startCloseMu.Unlock()
+	if t.ctx.Err() != nil {
+		return t.ctx.Err()
+	}
+	t.inboundForwardMu.Lock()
+	if t.inboundForwards != nil {
+		t.inboundForwardMu.Unlock()
+		return nil
+	}
+	t.inboundForwardMu.Unlock()
+	if err := waitTailscaleIPs(ctx, t.server); err != nil {
+		return err
+	}
+	forwardSet, err := startTailscaleInboundForwardSet(t.ctx, t.Name(), t.server, t.option.InboundForwards, defaultTailscaleUDPForwardTimeout)
+	if err != nil {
+		return err
+	}
+	t.inboundForwardMu.Lock()
+	defer t.inboundForwardMu.Unlock()
+	if t.inboundForwards != nil {
+		_ = forwardSet.Close()
+		return nil
+	}
+	t.inboundForwards = forwardSet
+	return nil
+}
+
+func waitTailscaleIPs(ctx context.Context, server tailscaleForwardServer) error {
+	ticker := time.NewTicker(100 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		v4, v6 := server.TailscaleIPs()
+		if v4.IsValid() || v6.IsValid() {
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return fmt.Errorf("wait for tailscale addresses: %w", ctx.Err())
+		case <-ticker.C:
+		}
+	}
+}
+
+func startTailscaleInboundForwardSet(parent context.Context, proxyName string, server tailscaleForwardServer, forwards []TailscaleInboundForward, udpTimeout time.Duration) (*tailscaleInboundForwardSet, error) {
+	ctx, cancel := context.WithCancel(parent)
+	set := &tailscaleInboundForwardSet{
+		proxyName:   proxyName,
+		ctx:         ctx,
+		cancel:      cancel,
+		udpTimeout:  udpTimeout,
+		connections: make(map[net.Conn]struct{}),
+		udpSessions: make(map[string]*tailscaleUDPForwardSession),
+	}
+	hasUDP := false
+	for _, forward := range forwards {
+		switch forward.Network {
+		case "tcp":
+			listener, err := server.Listen("tcp", fmt.Sprintf(":%d", forward.ListenPort))
+			if err != nil {
+				_ = set.Close()
+				return nil, fmt.Errorf("inbound forward %q listen on tailnet tcp/%d: %w", forward.Name, forward.ListenPort, err)
+			}
+			set.addCloser(listener)
+			set.wg.Add(1)
+			go set.acceptTCP(forward, listener)
+		case "udp":
+			packetConns, err := listenTailscaleUDP(server, forward.ListenPort)
+			if err != nil {
+				_ = set.Close()
+				return nil, fmt.Errorf("inbound forward %q listen on tailnet udp/%d: %w", forward.Name, forward.ListenPort, err)
+			}
+			for _, packetConn := range packetConns {
+				set.addCloser(packetConn)
+				set.wg.Add(1)
+				go set.readUDP(forward, packetConn)
+			}
+			hasUDP = true
+		}
+		log.Infoln("[Tailscale](%s) inbound forward [%s] listening on tailnet %s/%d -> %s", proxyName, forward.Name, forward.Network, forward.ListenPort, forward.Target)
+	}
+	if hasUDP {
+		set.wg.Add(1)
+		go set.expireUDPSessions()
+	}
+	return set, nil
+}
+
+func listenTailscaleUDP(server tailscaleForwardServer, port int) ([]net.PacketConn, error) {
+	v4, v6 := server.TailscaleIPs()
+	addresses := make([]netip.Addr, 0, 2)
+	if v4.IsValid() {
+		addresses = append(addresses, v4)
+	}
+	if v6.IsValid() {
+		addresses = append(addresses, v6)
+	}
+	if len(addresses) == 0 {
+		return nil, errors.New("tailscale node has no assigned addresses")
+	}
+	packetConns := make([]net.PacketConn, 0, len(addresses))
+	for _, address := range addresses {
+		network := "udp4"
+		if address.Is6() {
+			network = "udp6"
+		}
+		packetConn, err := server.ListenPacket(network, netip.AddrPortFrom(address, uint16(port)).String())
+		if err != nil {
+			for _, opened := range packetConns {
+				_ = opened.Close()
+			}
+			return nil, err
+		}
+		packetConns = append(packetConns, packetConn)
+	}
+	return packetConns, nil
+}
+
+func (s *tailscaleInboundForwardSet) addCloser(closer io.Closer) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.closers = append(s.closers, closer)
+}
+
+func (s *tailscaleInboundForwardSet) acceptTCP(forward TailscaleInboundForward, listener net.Listener) {
+	defer s.wg.Done()
+	for {
+		connection, err := listener.Accept()
+		if err != nil {
+			if s.ctx.Err() == nil && !errors.Is(err, net.ErrClosed) {
+				log.Errorln("[Tailscale](%s) inbound forward [%s] accept failed: %v", s.proxyName, forward.Name, err)
+			}
+			return
+		}
+		if !s.startTCPConnection(connection) {
+			continue
+		}
+		go s.forwardTCP(forward, connection)
+	}
+}
+
+func (s *tailscaleInboundForwardSet) forwardTCP(forward TailscaleInboundForward, source net.Conn) {
+	defer s.wg.Done()
+	defer s.untrackConnection(source)
+	dialer := net.Dialer{Timeout: C.DefaultTCPTimeout}
+	target, err := dialer.DialContext(s.ctx, "tcp", forward.Target)
+	if err != nil {
+		if s.ctx.Err() == nil {
+			log.Warnln("[Tailscale](%s) inbound forward [%s] target %s rejected connection from %s: %v", s.proxyName, forward.Name, forward.Target, source.RemoteAddr(), err)
+		}
+		return
+	}
+	if !s.trackConnection(target) {
+		return
+	}
+	defer s.untrackConnection(target)
+	log.Debugln("[Tailscale](%s) inbound forward [%s] connected %s -> %s", s.proxyName, forward.Name, source.RemoteAddr(), forward.Target)
+	N.Relay(source, target)
+	log.Debugln("[Tailscale](%s) inbound forward [%s] closed %s -> %s", s.proxyName, forward.Name, source.RemoteAddr(), forward.Target)
+}
+
+func (s *tailscaleInboundForwardSet) startTCPConnection(connection net.Conn) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		_ = connection.Close()
+		return false
+	}
+	s.connections[connection] = struct{}{}
+	s.wg.Add(1)
+	return true
+}
+
+func (s *tailscaleInboundForwardSet) trackConnection(connection net.Conn) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		_ = connection.Close()
+		return false
+	}
+	s.connections[connection] = struct{}{}
+	return true
+}
+
+func (s *tailscaleInboundForwardSet) untrackConnection(connection net.Conn) {
+	s.mu.Lock()
+	delete(s.connections, connection)
+	s.mu.Unlock()
+	_ = connection.Close()
+}
+
+func (s *tailscaleInboundForwardSet) readUDP(forward TailscaleInboundForward, packetConn net.PacketConn) {
+	defer s.wg.Done()
+	buffer := make([]byte, 64*1024)
+	for {
+		count, remote, err := packetConn.ReadFrom(buffer)
+		if err != nil {
+			if s.ctx.Err() == nil && !errors.Is(err, net.ErrClosed) {
+				log.Errorln("[Tailscale](%s) inbound forward [%s] read udp failed: %v", s.proxyName, forward.Name, err)
+			}
+			return
+		}
+		session, err := s.getOrCreateUDPSession(forward, packetConn, remote)
+		if err != nil {
+			if s.ctx.Err() == nil {
+				log.Warnln("[Tailscale](%s) inbound forward [%s] target %s rejected udp from %s: %v", s.proxyName, forward.Name, forward.Target, remote, err)
+			}
+			continue
+		}
+		session.lastSeen.Store(time.Now().UnixNano())
+		if _, err = session.target.Write(buffer[:count]); err != nil {
+			log.Warnln("[Tailscale](%s) inbound forward [%s] write udp to target %s failed: %v", s.proxyName, forward.Name, forward.Target, err)
+			s.removeUDPSession(session)
+		}
+	}
+}
+
+func (s *tailscaleInboundForwardSet) getOrCreateUDPSession(forward TailscaleInboundForward, packetConn net.PacketConn, remote net.Addr) (*tailscaleUDPForwardSession, error) {
+	key := forward.Name + "\x00" + packetConn.LocalAddr().String() + "\x00" + remote.String()
+	s.mu.Lock()
+	if session := s.udpSessions[key]; session != nil {
+		s.mu.Unlock()
+		return session, nil
+	}
+	if s.closed {
+		s.mu.Unlock()
+		return nil, net.ErrClosed
+	}
+	s.mu.Unlock()
+
+	dialer := net.Dialer{Timeout: C.DefaultUDPTimeout}
+	target, err := dialer.DialContext(s.ctx, "udp", forward.Target)
+	if err != nil {
+		return nil, err
+	}
+	session := &tailscaleUDPForwardSession{
+		key:        key,
+		forward:    forward,
+		packetConn: packetConn,
+		remote:     cloneUDPAddr(remote),
+		target:     target,
+	}
+	session.lastSeen.Store(time.Now().UnixNano())
+
+	s.mu.Lock()
+	if existing := s.udpSessions[key]; existing != nil {
+		s.mu.Unlock()
+		_ = target.Close()
+		return existing, nil
+	}
+	if s.closed {
+		s.mu.Unlock()
+		_ = target.Close()
+		return nil, net.ErrClosed
+	}
+	s.udpSessions[key] = session
+	s.wg.Add(1)
+	s.mu.Unlock()
+
+	go s.readUDPResponses(session)
+	return session, nil
+}
+
+func cloneUDPAddr(address net.Addr) net.Addr {
+	if udpAddress, ok := address.(*net.UDPAddr); ok {
+		clone := *udpAddress
+		clone.IP = append(net.IP(nil), udpAddress.IP...)
+		return &clone
+	}
+	return address
+}
+
+func (s *tailscaleInboundForwardSet) readUDPResponses(session *tailscaleUDPForwardSession) {
+	defer s.wg.Done()
+	defer s.removeUDPSession(session)
+	buffer := make([]byte, 64*1024)
+	for {
+		count, err := session.target.Read(buffer)
+		if err != nil {
+			if s.ctx.Err() == nil && !errors.Is(err, net.ErrClosed) {
+				log.Debugln("[Tailscale](%s) inbound forward [%s] udp session %s closed: %v", s.proxyName, session.forward.Name, session.remote, err)
+			}
+			return
+		}
+		session.lastSeen.Store(time.Now().UnixNano())
+		if _, err = session.packetConn.WriteTo(buffer[:count], session.remote); err != nil {
+			if s.ctx.Err() == nil && !errors.Is(err, net.ErrClosed) {
+				log.Warnln("[Tailscale](%s) inbound forward [%s] write udp response to %s failed: %v", s.proxyName, session.forward.Name, session.remote, err)
+			}
+			return
+		}
+	}
+}
+
+func (s *tailscaleInboundForwardSet) expireUDPSessions() {
+	defer s.wg.Done()
+	interval := s.udpTimeout / 2
+	if interval < 100*time.Millisecond {
+		interval = 100 * time.Millisecond
+	}
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-s.ctx.Done():
+			return
+		case now := <-ticker.C:
+			var expired []*tailscaleUDPForwardSession
+			s.mu.Lock()
+			for _, session := range s.udpSessions {
+				lastSeen := time.Unix(0, session.lastSeen.Load())
+				if now.Sub(lastSeen) >= s.udpTimeout {
+					expired = append(expired, session)
+				}
+			}
+			s.mu.Unlock()
+			for _, session := range expired {
+				s.removeUDPSession(session)
+			}
+		}
+	}
+}
+
+func (s *tailscaleInboundForwardSet) removeUDPSession(session *tailscaleUDPForwardSession) {
+	s.mu.Lock()
+	if s.udpSessions[session.key] == session {
+		delete(s.udpSessions, session.key)
+	}
+	s.mu.Unlock()
+	session.closeOnce.Do(func() {
+		_ = session.target.Close()
+	})
+}
+
+func (s *tailscaleInboundForwardSet) Close() error {
+	s.closeOnce.Do(func() {
+		s.cancel()
+		s.mu.Lock()
+		s.closed = true
+		closers := append([]io.Closer(nil), s.closers...)
+		connections := make([]net.Conn, 0, len(s.connections))
+		for connection := range s.connections {
+			connections = append(connections, connection)
+		}
+		sessions := make([]*tailscaleUDPForwardSession, 0, len(s.udpSessions))
+		for _, session := range s.udpSessions {
+			sessions = append(sessions, session)
+		}
+		s.mu.Unlock()
+		for _, closer := range closers {
+			if err := closer.Close(); err != nil && !errors.Is(err, net.ErrClosed) {
+				s.closeErr = errors.Join(s.closeErr, err)
+			}
+		}
+		for _, connection := range connections {
+			_ = connection.Close()
+		}
+		for _, session := range sessions {
+			s.removeUDPSession(session)
+		}
+		s.wg.Wait()
+	})
+	return s.closeErr
+}
+
+func HasInboundForwards(proxy C.ProxyAdapter) bool {
+	switch typed := proxy.(type) {
+	case *autoCloseProxyAdapter:
+		return HasInboundForwards(typed.ProxyAdapter)
+	case *SingMux:
+		return HasInboundForwards(typed.ProxyAdapter)
+	case *Tailscale:
+		return len(typed.option.InboundForwards) > 0
+	default:
+		return false
+	}
+}
+
+func TailscaleStateDir(proxy C.ProxyAdapter) (string, bool) {
+	switch typed := proxy.(type) {
+	case *autoCloseProxyAdapter:
+		return TailscaleStateDir(typed.ProxyAdapter)
+	case *SingMux:
+		return TailscaleStateDir(typed.ProxyAdapter)
+	case *Tailscale:
+		return typed.option.StateDir, true
+	default:
+		return "", false
+	}
+}
+
+func StartInboundForwards(proxy C.ProxyAdapter) (bool, error) {
+	switch typed := proxy.(type) {
+	case *autoCloseProxyAdapter:
+		return StartInboundForwards(typed.ProxyAdapter)
+	case *SingMux:
+		return StartInboundForwards(typed.ProxyAdapter)
+	case *Tailscale:
+		if len(typed.option.InboundForwards) == 0 {
+			return false, nil
+		}
+		return true, typed.startInboundForwards()
+	default:
+		return false, nil
+	}
+}
