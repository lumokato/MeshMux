diff --git a/adapter/outbound/tailscale_forward_test.go b/adapter/outbound/tailscale_forward_test.go
new file mode 100644
index 00000000..aa8420d1
--- /dev/null
+++ b/adapter/outbound/tailscale_forward_test.go
@@ -0,0 +1,146 @@
+//go:build with_gvisor && !no_tailscale
+
+package outbound
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+)
+
+type fakeTailscaleForwardServer struct {
+	tcpListeners []net.Listener
+	packetConns  []net.PacketConn
+}
+
+func (s *fakeTailscaleForwardServer) Listen(network, address string) (net.Listener, error) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err == nil {
+		s.tcpListeners = append(s.tcpListeners, listener)
+	}
+	return listener, err
+}
+
+func (s *fakeTailscaleForwardServer) ListenPacket(network, address string) (net.PacketConn, error) {
+	packetConn, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err == nil {
+		s.packetConns = append(s.packetConns, packetConn)
+	}
+	return packetConn, err
+}
+
+func (s *fakeTailscaleForwardServer) TailscaleIPs() (netip.Addr, netip.Addr) {
+	return netip.MustParseAddr("100.64.0.1"), netip.Addr{}
+}
+
+func TestTailscaleInboundTCPForwardBidirectionalAndClose(t *testing.T) {
+	targetListener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer targetListener.Close()
+	go func() {
+		connection, acceptErr := targetListener.Accept()
+		if acceptErr != nil {
+			return
+		}
+		defer connection.Close()
+		_, _ = io.Copy(connection, connection)
+	}()
+
+	server := &fakeTailscaleForwardServer{}
+	forwardSet, err := startTailscaleInboundForwardSet(context.Background(), "test", server, []TailscaleInboundForward{{
+		Name:       "echo",
+		Network:    "tcp",
+		ListenPort: 12345,
+		Target:     targetListener.Addr().String(),
+	}}, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client, err := net.Dial("tcp", server.tcpListeners[0].Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	message := []byte("tailnet-forward")
+	if _, err = client.Write(message); err != nil {
+		t.Fatal(err)
+	}
+	response := make([]byte, len(message))
+	if _, err = io.ReadFull(client, response); err != nil {
+		t.Fatal(err)
+	}
+	if string(response) != string(message) {
+		t.Fatalf("response = %q", response)
+	}
+	if err = forwardSet.Close(); err != nil {
+		t.Fatal(err)
+	}
+	_ = client.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err = client.Read(make([]byte, 1)); err == nil {
+		t.Fatal("active forwarded connection remained open after close")
+	}
+	if _, err = net.DialTimeout("tcp", server.tcpListeners[0].Addr().String(), 200*time.Millisecond); err == nil {
+		t.Fatal("tailnet listener remained open after close")
+	}
+}
+
+func TestTailscaleInboundUDPForward(t *testing.T) {
+	target, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer target.Close()
+	go func() {
+		buffer := make([]byte, 1024)
+		count, remote, readErr := target.ReadFrom(buffer)
+		if readErr == nil {
+			_, _ = target.WriteTo(buffer[:count], remote)
+		}
+	}()
+
+	server := &fakeTailscaleForwardServer{}
+	forwardSet, err := startTailscaleInboundForwardSet(context.Background(), "test", server, []TailscaleInboundForward{{
+		Name:       "echo-udp",
+		Network:    "udp",
+		ListenPort: 12345,
+		Target:     target.LocalAddr().String(),
+	}}, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer forwardSet.Close()
+	client, err := net.Dial("udp", server.packetConns[0].LocalAddr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	_ = client.SetDeadline(time.Now().Add(2 * time.Second))
+	message := []byte("tailnet-udp")
+	if _, err = client.Write(message); err != nil {
+		t.Fatal(err)
+	}
+	response := make([]byte, len(message))
+	if _, err = io.ReadFull(client, response); err != nil {
+		t.Fatal(err)
+	}
+	if string(response) != string(message) {
+		t.Fatalf("response = %q", response)
+	}
+}
+
+func TestTailscaleStateDirUnwrapsAdapters(t *testing.T) {
+	tailscale, err := NewTailscale(TailscaleOption{Name: "test", StateDir: "tailscale-state-dir-test"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tailscale.Close()
+	wrapped := NewAutoCloseProxyAdapter(tailscale)
+	stateDir, ok := TailscaleStateDir(wrapped)
+	if !ok || stateDir != tailscale.option.StateDir {
+		t.Fatalf("state dir = %q, %v", stateDir, ok)
+	}
+}
